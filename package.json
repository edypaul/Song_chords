{
  "name": "song-chords",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/desktop"
  ],
  "scripts": {
    "desktop": "yarn workspace @song-chords/desktop dev",
    "build:shared": "yarn workspace @song-chords/shared build",
    "build:desktop": "yarn workspace @song-chords/desktop build",
    "test": "yarn workspace @song-chords/shared test",
    "lint": "eslint packages/*/src --ext .ts,.tsx",
    "agents": "cd agents && npx tsx index.ts",
    "agents:run": "cd agents && npx tsx index.ts"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
