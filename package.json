{
  "name": "song-chords",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/shared",
      "packages/desktop"
    ],
    "nohoist": [
      "**/electron",
      "**/electron/**",
      "**/electron-builder",
      "**/electron-builder/**",
      "**/electron-vite",
      "**/electron-vite/**"
    ]
  },
  "scripts": {
    "desktop": "yarn workspace @song-chords/desktop dev",
    "build:shared": "yarn workspace @song-chords/shared build",
    "build:desktop": "yarn workspace @song-chords/desktop build",
    "package": "yarn workspace @song-chords/desktop package",
    "package:dir": "yarn workspace @song-chords/desktop package:dir",
    "test": "yarn workspace @song-chords/shared test",
    "lint": "eslint packages/*/src --ext .ts,.tsx",
    "agents": "cd agents && npx tsx index.ts",
    "agents:run": "cd agents && npx tsx index.ts"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
